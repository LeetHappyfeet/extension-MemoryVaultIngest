/* MemoryVaultIngest v0.3.7 – Reliable user line fix
 * - Uses MESSAGE_SENT for user lines (post-event chat sync via setTimeout)
 * - MESSAGE_RECEIVED for agent lines remains unchanged
 * - Includes debug logs for event tracing
 */

import { eventSource, event_types } from "../../../../script.js";

const API_ROOT   = "http://192.168.1.205:8000";
const API_SESS   = `${API_ROOT}/session`;
const API_INGEST = `${API_ROOT}/ingest`;

const LISTEN_USER = event_types?.MESSAGE_SENT ?? "message_sent";       // user line (sent)
const LISTEN_AI   = event_types?.MESSAGE_RECEIVED ?? "message_received"; // character line (received)

let sessionId = null;
let lastHash  = null;

/* ------------------------------------------------------------------ */
async function openSession(ctx) {
  if (sessionId) return sessionId;
  const topic = `${ctx.characterId ?? "chat"}-${Date.now()}`;
  try {
    const res = await fetch(API_SESS, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ topic }),
    });
    if (!res.ok) throw new Error(await res.text());
    sessionId = (await res.json()).session_id;
    console.debug("[MemoryVaultIngest] ↯ new session", sessionId);
  } catch (err) {
    console.error("[MemoryVaultIngest] ❌ session create failed", err);
  }
  return sessionId;
}

/* ------------------------------------------------------------------ */
async function pushLine(speakerType) {
  const ctx = SillyTavern.getContext();
  const msg = ctx.chat?.[ctx.chat.length - 1];

  if (!msg || !msg.mes) {
    console.warn("[MemoryVaultIngest] ⚠️ No message found at ctx.chat[-1]");
    return;
  }

  const hash = `${speakerType}::${msg.mes}`;
  if (hash === lastHash) return;
  lastHash = hash;

  await openSession(ctx);

  const speakerId   = speakerType === "user" ? ctx.name1 : ctx.name2;
  const recipientId = ctx.groupId ? null : speakerType === "user" ? ctx.name2 : ctx.name1;

  const payload = {
    session_id:   sessionId,
    speaker_id:   speakerId,
    speaker_type: speakerType,
    recipient_id: recipientId,
    character_id: String(ctx.characterId ?? ""),
    user_name:    ctx.name1,
    text:         msg.mes,
  };

  try {
    const res = await fetch(API_INGEST, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
    if (!res.ok) {
      console.error(`[MemoryVaultIngest] ${res.status}:`, await res.text());
    } else {
      console.debug(`[MemoryVaultIngest] (${speakerType}) ✔ stored`, await res.json());
    }
  } catch (err) {
    console.error("[MemoryVaultIngest] ❌ fetch failed", err);
  }
}

/* ------------------------------------------------------------------ */
console.log(`[MemoryVaultIngest] v0.3.7 loaded – listening on "${LISTEN_USER}" & "${LISTEN_AI}"`);

eventSource.on(LISTEN_USER, () => {
  console.debug("[MemoryVaultIngest] 📨 MESSAGE_SENT triggered – waiting for ctx.chat sync");
  setTimeout(() => pushLine("user"), 0);
});

eventSource.on(LISTEN_AI, () => {
  console.debug("[MemoryVaultIngest] 🤖 MESSAGE_RECEIVED triggered");
  pushLine("character");
});