/* MemoryVaultIngest v0.3.3 – guarantees user + character lines
 * Strategy:
 *   • Distinguish MESSAGE_SENT (user) vs MESSAGE_RECEIVED (AI/agent)
 *   • Pull speaker names directly from context (name1 / name2) instead of msg.name
 *   • Bypass quirks where user lines inherit character name in msg object
 *   • Simple hash‑based dedupe for double RECEIVE events
 */

import { eventSource, event_types } from "../../../../script.js";

const API_ROOT   = "http://192.168.1.205:8000";
const API_SESS   = `${API_ROOT}/session`;
const API_INGEST = `${API_ROOT}/ingest`;

const LISTEN_SENT     = event_types?.MESSAGE_SENT     ?? "message_sent";     // user line
const LISTEN_RECEIVED = event_types?.MESSAGE_RECEIVED ?? "message_received"; // AI line

let sessionId = null;
let lastHash  = null;   // dedupe guard

/* ------------------------------------------------------------------ */
/*  Helper – open (or reuse) a conversation_session row               */
/* ------------------------------------------------------------------ */
async function openSession(ctx) {
  if (sessionId) return sessionId;
  const topic = `${ctx.characterId ?? "chat"}-${Date.now()}`;
  try {
    const res = await fetch(API_SESS, {
      method:  "POST",
      headers: { "Content-Type": "application/json" },
      body:    JSON.stringify({ topic })
    });
    if (!res.ok) throw new Error(await res.text());
    sessionId = (await res.json()).session_id;
    console.debug("[MemoryVaultIngest] ↯ new session", sessionId);
  } catch (err) {
    console.error("[MemoryVaultIngest] ❌ session create failed", err);
  }
  return sessionId;
}

/* ------------------------------------------------------------------ */
/*  Core – send one line to Memory‑Vault                              */
/* ------------------------------------------------------------------ */
async function pushLine(evtName, msg) {
  if (!msg || !msg.mes) return;                // nothing to send

  // skip duplicates (common on MESSAGE_RECEIVED re‑fires)
  const hash = `${evtName}::${msg.mes}`;
  if (hash === lastHash) return;
  lastHash = hash;

  const ctx = SillyTavern.getContext();
  await openSession(ctx);

  // Derive speaker metadata from event type
  const speakerType = evtName === LISTEN_SENT ? "user" : "character";
  const speakerId   = speakerType === "user" ? ctx.name1 : ctx.name2;
  const recipientId = ctx.groupId
        ? null
        : speakerType === "user" ? ctx.name2 : ctx.name1;

  const payload = {
    session_id:   sessionId,
    speaker_id:   speakerId,
    speaker_type: speakerType,
    recipient_id: recipientId,
    character_id: String(ctx.characterId ?? ""),
    user_name:    ctx.name1,
    text:         msg.mes
  };

  try {
    const res = await fetch(API_INGEST, {
      method:  "POST",
      headers: { "Content-Type": "application/json" },
      body:    JSON.stringify(payload)
    });
    if (!res.ok) {
      console.error(`[MemoryVaultIngest] ${res.status}:`, await res.text());
    } else {
      console.debug(`[MemoryVaultIngest] (${speakerType}) ✔ stored`, await res.json());
    }
  } catch (err) {
    console.error("[MemoryVaultIngest] ❌ fetch failed", err);
  }
}

/* ------------------------------------------------------------------ */
/*  Register listeners with explicit event name                        */
/* ------------------------------------------------------------------ */
console.log(`[MemoryVaultIngest] v0.3.3 loaded – watching \"${LISTEN_SENT}\" & \"${LISTEN_RECEIVED}\"`);

eventSource.on(LISTEN_SENT,     (msg)=>pushLine(LISTEN_SENT,     msg));
eventSource.on(LISTEN_RECEIVED, (msg)=>pushLine(LISTEN_RECEIVED, msg));